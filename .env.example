# Postgres (docker compose exposes 5433; a local Postgres on 5432 works too)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ek_porichoy
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret used by bank / MFS partners to sign settlement callbacks (HMAC-SHA256)
PAYER_WEBHOOK_SECRET=change-me-payer-secret

# Serverless / Neon (production)
# DATABASE_URL=<pooled>  DATABASE_URL_UNPOOLED=<direct, used for migrations>
DB_PGBOUNCER=false
DB_POOL_MAX=10
# Show OTP on screen and list demo accounts (public demo without SMS gateway)
DEMO_MODE=false

# Analytics (self-hosted Umami). Leave the website ID empty to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.online360.org/script.js
# NEXT_PUBLIC_UMAMI_DOMAINS=ekporichoy.online360.org
